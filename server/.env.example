PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=tcy_token
CLIENT_ORIGIN=https://yourdomain.com
GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH_CALLBACK_URL=https://yourdomain.com/auth/callback
USE_SUPABASE=true
SUPABASE_URL=https://yourdomain.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NODE_ENV=production

# Cloudinary upload credentials for gallery images
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=courtyard/gallery

# Optional: seed a Firebase admin login user on server startup
# If both are set, startup will create/update this account and force role=admin in users/<uid>
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=ChangeThisAdminPass123!
ADMIN_SEED_NAME=Platform Admin
